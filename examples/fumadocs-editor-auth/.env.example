# Copy to .env.local. Every variable the authenticated editor Example reads
# lives here. The build needs none of them; they are checked together on the
# first request, and one error lists everything missing or malformed.

# --- Sign-in (Better Auth + a GitHub OAuth App) -----------------------------
# Signing in proves who someone is; it grants no repo access. Create the OAuth
# App at https://github.com/settings/developers with the callback URL
# <BETTER_AUTH_URL>/api/auth/callback/github.
# A random secret of at least 32 characters (openssl rand -base64 32).
# Rotating it signs everyone out: that is the kill switch.
BETTER_AUTH_SECRET=
# The site's public origin, e.g. https://wiki.example.com or http://localhost:3000.
BETTER_AUTH_URL=
# The OAuth App's Client ID and a Client secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- The Vault's repository --------------------------------------------------
# owner/name. Required in production (the server refuses to start without it).
# Leave unset in development to use the local filesystem.
GITHUB_REPO=
# The branch the Wiki is deployed from. Defaults to the repo's default branch.
GITHUB_BRANCH=
# The Vault's subdirectory inside the repo, e.g. public/vault. "View on GitHub"
# appears only when GITHUB_REPO, GITHUB_BRANCH and VAULT_PATH are all set.
VAULT_PATH=

# --- The credential that commits Saves (server only; never sent to browsers) -
# Either a fine-grained personal access token with Contents read/write on the
# Vault repo only...
GITHUB_TOKEN=
# ...or a GitHub App installed on that repo only (it wins if both are set).
# Write the private key on one line with literal \n for newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Where the Vault is built from -------------------------------------------
# Local directory to publish instead of public/vault.
# VAULT_DIR=

# --- Overrides for tests (leave unset) ---------------------------------------
# Point sign-in at a fake GitHub. The Playwright suite sets these.
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_API_URL=https://api.github.com
# Comma-separated logins the access hook rejects; honoured only when
# GITHUB_OAUTH_URL is set.
# TEST_DENY_LOGINS=
