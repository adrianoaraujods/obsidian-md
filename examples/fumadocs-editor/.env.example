# Copy to .env.local. Every variable the editor Examples read lives here.
# This open editor Example needs none of them to run; only the three marked
# "View on GitHub" below are read today.

# --- View on GitHub (all three must be set, or the link is hidden) ---------
# The Vault's repository, as owner/name.
GITHUB_REPO=
# The branch the Wiki is deployed from.
GITHUB_BRANCH=
# The Vault's subdirectory inside the repo, e.g. public/vault.
VAULT_PATH=

# --- Where the Vault is built from ------------------------------------------
# Local directory to publish instead of public/vault.
# VAULT_DIR=
