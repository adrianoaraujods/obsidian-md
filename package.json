{
  "name": "obsidian-md",
  "private": true,
  "description": "Monorepo for remark-obsidian-md and the packages built on it",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianoaraujods/obsidian-md.git"
  },
  "homepage": "https://github.com/adrianoaraujods/obsidian-md#readme",
  "bugs": {
    "url": "https://github.com/adrianoaraujods/obsidian-md/issues"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "biome format --write",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7"
  }
}
