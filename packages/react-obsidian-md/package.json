{
  "name": "react-obsidian-md",
  "version": "0.0.0",
  "author": "Adriano Araújo (adrianoaraujodsantos@hotmail.com)",
  "description": "Headless React components for Obsidian.md content: a collapsible Properties Panel with persisted state, styled entirely by your own CSS",
  "license": "MIT",
  "keywords": [
    "react",
    "headless",
    "obsidian",
    "properties",
    "frontmatter",
    "digital-garden",
    "remark-obsidian-md"
  ],
  "homepage": "https://github.com/adrianoaraujods/obsidian-md/tree/main/packages/react-obsidian-md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianoaraujods/obsidian-md.git",
    "directory": "packages/react-obsidian-md"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-obsidian-md": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^27.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-obsidian-md": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/adrianoaraujods/obsidian-md/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
